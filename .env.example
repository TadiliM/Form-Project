# Copy this file to `.env` and fill in real values before running `docker compose up`.

POSTGRES_DB=formproject
POSTGRES_USER=formproject
POSTGRES_PASSWORD=change-me

# Generate with: openssl rand -base64 48
JWT_KEY=a-long-random-secret-at-least-32-characters-long

SITE_DOMAIN=localhost
SITE_URL=http://localhost:3000

# Get these from https://dashboard.stripe.com/test/apikeys and /products
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
